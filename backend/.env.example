# ─────────────────────────────────────────────
# CloudRakshak Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────

# Server
PORT=3001
NODE_ENV=development

# PostgreSQL (local or Supabase/Neon free tier)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/cloudrakshak"

# ─── AWS (Feature 6 — leave blank during mock development) ───
# The ARN of the read-only IAM role CloudRakshak will assume.
# See docs/iam-setup.md for how to create this role safely.
AWS_ROLE_ARN=
AWS_REGION=ap-south-1

# ─── Telegram Bot (Feature 4) ───
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Currency (used for INR conversion on dashboard) ───
# 1 USD = X INR — update periodically or wire up a live FX API later
USD_TO_INR_RATE=84
